{
  "_comment": "Catálogo de perfis de apps para o Marvin. Adicione novos apps aqui sem alterar Python.",
  "_schema": {
    "detect": {
      "cli": "nome do comando no PATH (shutil.which)",
      "app_name": "nome para busca no AppDiscovery (registro/atalhos do sistema)"
    },
    "capabilities": {
      "type": "'cli' roda subprocess | 'uri' abre URI/protocolo via os.startfile",
      "args": "lista de strings; use {param} para interpolar parâmetros",
      "uri": "string URI; use {param} para interpolar parâmetros",
      "params": "lista de {name, type, description, required}",
      "response": "mensagem de sucesso com {param} interpolados"
    }
  },

  "vscode": {
    "display_name": "Visual Studio Code",
    "detect": { "cli": "code" },
    "capabilities": [
      {
        "id": "open_folder",
        "description": "Abre uma pasta no VSCode (reutiliza a janela atual se já estiver aberto)",
        "type": "cli",
        "command": "code",
        "args": ["--reuse-window", "{path}"],
        "params": [
          { "name": "path", "type": "string", "description": "Caminho completo da pasta a abrir", "required": true }
        ],
        "response": "Abrindo '{path}' no VSCode."
      },
      {
        "id": "open_folder_new_window",
        "description": "Abre uma pasta em uma NOVA janela do VSCode",
        "type": "cli",
        "command": "code",
        "args": ["--new-window", "{path}"],
        "params": [
          { "name": "path", "type": "string", "description": "Caminho completo da pasta a abrir", "required": true }
        ],
        "response": "Abrindo '{path}' em nova janela do VSCode."
      },
      {
        "id": "open_file",
        "description": "Abre um arquivo específico no VSCode, opcionalmente numa linha",
        "type": "cli",
        "command": "code",
        "args": ["--goto", "{file}"],
        "params": [
          { "name": "file", "type": "string", "description": "Caminho do arquivo (pode incluir :linha, ex: main.py:42)", "required": true }
        ],
        "response": "Abrindo arquivo '{file}' no VSCode."
      },
      {
        "id": "diff",
        "description": "Abre o diff entre dois arquivos no VSCode",
        "type": "cli",
        "command": "code",
        "args": ["--diff", "{file1}", "{file2}"],
        "params": [
          { "name": "file1", "type": "string", "description": "Caminho do primeiro arquivo", "required": true },
          { "name": "file2", "type": "string", "description": "Caminho do segundo arquivo", "required": true }
        ],
        "response": "Abrindo diff entre '{file1}' e '{file2}' no VSCode."
      }
    ]
  },

  "steam": {
    "display_name": "Steam",
    "detect": { "app_name": "Steam" },
    "capabilities": [
      {
        "id": "search_game",
        "description": "Abre o cliente Steam na tela de busca pelo jogo solicitado",
        "type": "uri",
        "uri": "steam://search/{query}",
        "params": [
          { "name": "query", "type": "string", "description": "Nome do jogo a buscar na Steam", "required": true }
        ],
        "response": "Buscando '{query}' na Steam."
      },
      {
        "id": "launch_game",
        "description": "Inicia um jogo da Steam pelo App ID numérico. Use steam_find_game para descobrir o ID.",
        "type": "uri",
        "uri": "steam://run/{app_id}",
        "params": [
          { "name": "app_id", "type": "string", "description": "App ID numérico do jogo na Steam (ex: '730' para CS2)", "required": true }
        ],
        "response": "Iniciando jogo Steam (App ID: {app_id})."
      },
      {
        "id": "open_store_page",
        "description": "Abre a página da loja Steam de um jogo pelo App ID",
        "type": "uri",
        "uri": "steam://store/{app_id}",
        "params": [
          { "name": "app_id", "type": "string", "description": "App ID numérico do jogo na Steam", "required": true }
        ],
        "response": "Abrindo página da loja do jogo {app_id} na Steam."
      },
      {
        "id": "open_friends",
        "description": "Abre a lista de amigos no Steam",
        "type": "uri",
        "uri": "steam://open/friends",
        "params": [],
        "response": "Abrindo lista de amigos na Steam."
      }
    ]
  },

  "chrome": {
    "display_name": "Google Chrome",
    "detect": { "cli": "chrome" },
    "capabilities": [
      {
        "id": "open_url",
        "description": "Abre uma URL no Google Chrome",
        "type": "cli",
        "command": "chrome",
        "args": ["{url}"],
        "params": [
          { "name": "url", "type": "string", "description": "URL a abrir no Chrome", "required": true }
        ],
        "response": "Abrindo '{url}' no Chrome."
      },
      {
        "id": "open_incognito",
        "description": "Abre uma URL no Chrome em modo anônimo (incógnito)",
        "type": "cli",
        "command": "chrome",
        "args": ["--incognito", "{url}"],
        "params": [
          { "name": "url", "type": "string", "description": "URL a abrir no modo anônimo", "required": true }
        ],
        "response": "Abrindo '{url}' no Chrome em modo anônimo."
      }
    ]
  },

